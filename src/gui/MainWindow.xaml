<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEWIN Booster - Otimizador e Gerenciador do Windows"
        Height="800" Width="1100" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0F111A" Foreground="#C8D3F5"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Paleta de Cores Moderna (DEWIN Dark Theme) -->
        <SolidColorBrush x:Key="BgDark" Color="#0F111A" />
        <SolidColorBrush x:Key="BgCard" Color="#1A1B26" />
        <SolidColorBrush x:Key="BgCardAlt" Color="#24283B" />
        <SolidColorBrush x:Key="BorderCard" Color="#2F354F" />
        <SolidColorBrush x:Key="PrimaryCyan" Color="#7DCFFF" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#7AA2F7" />
        <SolidColorBrush x:Key="AccentGreen" Color="#9ECE6A" />
        <SolidColorBrush x:Key="AccentYellow" Color="#E0AF68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#C8D3F5" />
        <SolidColorBrush x:Key="TextMuted" Color="#7982A9" />

        <!-- Estilo dos CheckBoxes Modernos -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8D3F5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Estilo dos Botoes Secundarios -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#24283B" />
            <Setter Property="Foreground" Value="#C8D3F5" />
            <Setter Property="BorderBrush" Value="#414868" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Estilo dos Cards de Perfil e Agrupamentos -->
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1B26" />
            <Setter Property="BorderBrush" Value="#2F354F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <!-- Estilo Moderno da Barra de Progresso -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#24283B" />
            <Setter Property="Foreground" Value="#7DCFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid Name="PART_Track">
                                <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Cabecalho e Banner de Hardware -->
            <RowDefinition Height="*" />    <!-- Area Principal com Abas -->
        </Grid.RowDefinitions>

        <!-- 1. CABECALHO & BANNER DE HARDWARE -->
        <Border Grid.Row="0" Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DEWIN BOOSTER" FontSize="20" FontWeight="Bold" Foreground="#7DCFFF" VerticalAlignment="Center" />
                        <Border Background="#24283B" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nativo e de Código Aberto" FontSize="11" Foreground="#9ECE6A" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Name="txtHardwareBanner" Text="Detectando componentes de hardware..." FontSize="12" Foreground="#7982A9" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#24283B" BorderBrush="#414868" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="4,0">
                        <TextBlock Name="txtDeviceType" Text="Detectando..." FontSize="12" FontWeight="Bold" Foreground="#7AA2F7" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ABAS PRINCIPAIS -->
        <TabControl Name="mainTabControl" Grid.Row="1" Background="#13141F" BorderBrush="#2F354F">
            
            <!-- ======================================================== -->
            <!-- ABA 1: PROGRAMAS & APLICATIVOS (TELA INICIAL)            -->
            <!-- ======================================================== -->
            <TabItem Name="tabItemSoftwares" Header=" Programas e Aplicativos ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Cabecalho e Acoes Rapidas -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,6,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Instalação e Atualização de Softwares via Winget" FontSize="16" FontWeight="Bold" Foreground="#7DCFFF" />
                                    <TextBlock Text="Selecione os programas que deseja instalar silenciosamente no computador:" FontSize="12" Foreground="#7982A9" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="btnSelectEssentialApps" Content="Essenciais" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" ToolTip="Seleciona Visual C++, 7-Zip e Google Chrome" />
                                    <Button Name="btnSelectAllApps" Content="Marcar Todos" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                                    <Button Name="btnDeselectAllApps" Content="Desmarcar Todos" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Catalogo de Softwares em Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Coluna 1: Runtimes e Navegadores -->
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Runtimes e Utilitários Essenciais" FontSize="14" FontWeight="Bold" Foreground="#7DCFFF" Margin="0,0,0,8" />
                                        <CheckBox Name="appVcRedist64" Content="Visual C++ 2015-2022 (x64) - Pré-requisito para jogos e programas" IsChecked="False" />
                                        <CheckBox Name="appVcRedist86" Content="Visual C++ 2015-2022 (x86) - Compatibilidade de aplicativos 32-bit" IsChecked="False" />
                                        <CheckBox Name="app7zip" Content="7-Zip - Compactador e descompactador de alta performance" IsChecked="False" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Navegadores Web" FontSize="14" FontWeight="Bold" Foreground="#9ECE6A" Margin="0,0,0,8" />
                                        <CheckBox Name="appChrome" Content="Google Chrome - Navegador web moderno e seguro" IsChecked="False" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coluna 2: Desenvolvimento e Multimidia/Jogos -->
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Ferramentas de Desenvolvimento" FontSize="14" FontWeight="Bold" Foreground="#BB9AF7" Margin="0,0,0,8" />
                                        <CheckBox Name="appVsCode" Content="Visual Studio Code - Editor de código da Microsoft" IsChecked="False" />
                                        <CheckBox Name="appGit" Content="Git for Windows - Sistema distribuído de controle de versão" IsChecked="False" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Comunicação, Mídia e Jogos" FontSize="14" FontWeight="Bold" Foreground="#E0AF68" Margin="0,0,0,8" />
                                        <CheckBox Name="appDiscord" Content="Discord - Comunicação por voz, vídeo e texto" IsChecked="False" />
                                        <CheckBox Name="appSteam" Content="Steam - Plataforma de jogos e comunidade digital" IsChecked="False" />
                                        <CheckBox Name="appVlc" Content="VLC Media Player - Reprodutor de áudio e vídeo universal" IsChecked="False" />
                                        <CheckBox Name="appSpotify" Content="Spotify - Streaming de música e podcasts" IsChecked="False" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Card Independente de Acao e Progresso de Softwares -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="6,12,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Linha 1: Status da instalacao + Porcentagem -->
                                <TextBlock Name="lblStatusSoftwares" Grid.Row="0" Grid.Column="0"
                                           Text="A instalação é realizada em segundo plano via Winget oficial."
                                           FontSize="12" Foreground="#7982A9" VerticalAlignment="Center" Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Name="lblPercentSoftwares" Grid.Row="0" Grid.Column="1"
                                           Text="0%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                <!-- Linha 2: Barra de Progresso + Botao de Acao -->
                                <ProgressBar Name="pbSoftwares" Grid.Row="1" Grid.Column="0"
                                             Height="10" Minimum="0" Maximum="100" Value="0"
                                             Background="#13141F" Foreground="#38BDF8" BorderThickness="0"
                                             Margin="0,0,16,0" VerticalAlignment="Center" />

                                <Button Name="btnInstallSoftwares" Grid.Row="1" Grid.Column="1"
                                        Content="Instalar Programas Selecionados"
                                        Background="#2563EB" BorderBrush="#38BDF8" Foreground="White"
                                        FontWeight="Bold" FontSize="13" Padding="20,10" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== -->
            <!-- ABA 2: OTIMIZACOES DO SISTEMA E PERFIS                   -->
            <!-- ======================================================== -->
            <TabItem Name="tabItemTweaks" Header=" Otimizações do Sistema ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Notificacao de Recomendacao de Hardware -->
                        <Border Background="#1C2738" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                            <TextBlock Name="txtRecommendation" Text="Calculando melhor perfil para sua máquina..." FontSize="13" Foreground="#93C5FD" TextWrapping="Wrap" />
                        </Border>

                        <!-- Seção dos 3 Níveis Rápidos de Otimização -->
                        <TextBlock Text="Níveis Rápidos de Otimização:" FontSize="14" FontWeight="SemiBold" Foreground="#C8D3F5" Margin="8,4,8,8" />
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <!-- Card Pouco Otimizado -->
                            <Border Style="{StaticResource ProfileCard}">
                                <StackPanel>
                                    <TextBlock Text="Pouco Otimizado" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Text="Otimizações essenciais e seguras, mantendo a experiência clássica do Windows 11 intacta." FontSize="12" Foreground="#7982A9" Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="• Limpeza de arquivos temporários e SSD&#x0a;• Desativação de telemetria básica e Bing&#x0a;• Menus rápidos e suporte a caminhos longos" FontSize="11" Foreground="#C8D3F5" Margin="0,2,0,10" />
                                    <Button Name="btnPresetTweakLight" Content="Selecionar Pouco Otimizado" Style="{StaticResource SecondaryButton}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="White" />
                                </StackPanel>
                            </Border>

                            <!-- Card Médio (Recomendado) -->
                            <Border Style="{StaticResource ProfileCard}">
                                <StackPanel>
                                    <TextBlock Text="Médio (Recomendado)" FontSize="15" FontWeight="Bold" Foreground="#4ADE80" />
                                    <TextBlock Text="Equilíbrio ideal entre desempenho, privacidade, remoção de bloat e fluidez do sistema." FontSize="12" Foreground="#7982A9" Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="• Remoção de 28 bloatwares e telemetria&#x0a;• Baixa latência de rede e sem GameDVR&#x0a;• Menu clássico e hibernação inteligente" FontSize="11" Foreground="#C8D3F5" Margin="0,2,0,10" />
                                    <Button Name="btnPresetTweakMedium" Content="Selecionar Médio (Recomendado)" Style="{StaticResource SecondaryButton}" Background="#16A34A" BorderBrush="#22C55E" Foreground="White" />
                                </StackPanel>
                            </Border>

                            <!-- Card 100% Otimizado -->
                            <Border Style="{StaticResource ProfileCard}">
                                <StackPanel>
                                    <TextBlock Text="100% Otimizado" FontSize="15" FontWeight="Bold" Foreground="#BB9AF7" />
                                    <TextBlock Text="Máximo desempenho absoluto para jogadores, criadores e desenvolvedores exigentes." FontSize="12" Foreground="#7982A9" Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="• Todas as 28 otimizações ativadas&#x0a;• Calibração de GPU, CPU e memória&#x0a;• Relógio UTC e inicialização limpa" FontSize="11" Foreground="#C8D3F5" Margin="0,2,0,10" />
                                    <Button Name="btnPresetTweakAggressive" Content="Selecionar 100% Otimizado" Style="{StaticResource SecondaryButton}" Background="#7C3AED" BorderBrush="#8B5CF6" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Barra de Ferramentas de Selecao dos Tweaks -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Seleção Personalizada de Otimizações:" FontSize="14" FontWeight="Bold" Foreground="#C8D3F5" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Name="btnSelectAll" Content="Marcar Todos" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                                    <Button Name="btnDeselectAll" Content="Desmarcar Todos" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Grid de Tweaks por Categoria -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Coluna 1: Interface e Desempenho -->
                            <StackPanel Grid.Column="0">
                                <!-- Card Interface -->
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Interface e Barra de Tarefas" FontSize="14" FontWeight="Bold" Foreground="#7DCFFF" Margin="0,0,0,8" />
                                        <CheckBox Name="chkHideSearch" Content="Ocultar caixa de pesquisa na barra de tarefas" IsChecked="False" ToolTip="Oculta a barra de pesquisa e desativa destaques do Bing, busca remota na nuvem e rastreamento de localização." />
                                        <CheckBox Name="chkHideTaskView" Content="Ocultar botão de Visão de Tarefas (Task View)" IsChecked="False" ToolTip="Oculta o ícone da barra; o atalho Win+Tab permanece totalmente funcional." />
                                        <CheckBox Name="chkCenterTaskbar" Content="Alinhamento centralizado da barra de tarefas" IsChecked="False" ToolTip="Mantém a barra de tarefas centralizada no padrão moderno do Windows 11." />
                                        <CheckBox Name="chkTaskbarEndTask" Content="Ativar opção 'Finalizar Tarefa' no botão direito" IsChecked="False" ToolTip="Permite encerrar processos não responsivos diretamente pelo botão direito na barra de tarefas." />
                                        <CheckBox Name="chkClassicContextMenu" Content="Menu de contexto clássico (estilo Windows 10)" IsChecked="False" ToolTip="Exibe todas as opções do menu de contexto diretamente, sem submenus adicionais." />
                                        <CheckBox Name="chkLaunchToThisPC" Content="Abrir Explorador de Arquivos em 'Este Computador'" IsChecked="False" ToolTip="Configura o Explorador de Arquivos para iniciar nas unidades de disco, removendo páginas lentas de Início e Galeria." />
                                        <CheckBox Name="chkShowExtensionsAndHidden" Content="Exibir extensões e arquivos ocultos" IsChecked="False" ToolTip="Facilita a visualização de extensões de arquivos (.bat, .ps1, .json) e pastas de configuração." />
                                        <CheckBox Name="chkAlwaysShowScrollbars" Content="Manter barras de rolagem sempre visíveis" IsChecked="False" ToolTip="Evita que as barras de rolagem sejam ocultadas automaticamente pela interface." />
                                    </StackPanel>
                                </Border>

                                <!-- Card Desempenho -->
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Desempenho, Latência e Armazenamento" FontSize="14" FontWeight="Bold" Foreground="#9ECE6A" Margin="0,0,0,8" />
                                        <CheckBox Name="chkOptimizeNetworkLatency" Content="Otimizar latência de rede (NetworkThrottling)" IsChecked="False" ToolTip="Desativa a limitação de rede do Windows para menor latência em conexões e jogos." />
                                        <CheckBox Name="chkDisableGameDVR" Content="Desativar GameDVR e captura em segundo plano" IsChecked="False" ToolTip="Elimina sobrecarga de processador e placa de vídeo gerada por gravações automáticas de tela." />
                                        <CheckBox Name="chkLinearMouse" Content="Resposta linear do ponteiro do mouse (Precisão 1:1)" IsChecked="False" ToolTip="Desativa a aceleração artificial do ponteiro para consistência de movimento." />
                                        <CheckBox Name="chkDisableStickyKeys" Content="Desativar atalho de Teclas de Aderência" IsChecked="False" ToolTip="Impede a exibição do diálogo de confirmação ao pressionar a tecla Shift consecutivamente." />
                                        <CheckBox Name="chkInstantMenuDelay" Content="Remover atraso na abertura de menus (0 ms)" IsChecked="False" ToolTip="Reduz o tempo de espera na abertura de submenus suspensos para resposta imediata." />
                                        <CheckBox Name="chkOptimizeSsdAccess" Content="Otimizar gravações em SSD (DisableLastAccess)" IsChecked="False" ToolTip="Desativa a gravação contínua de data de último acesso, reduzindo escritas e preservando o SSD." />
                                        <CheckBox Name="chkCleanTempFiles" Content="Limpar arquivos temporários do sistema" IsChecked="False" ToolTip="Esvazia caches e arquivos temporários não utilizados pelo sistema operacional." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coluna 2: Privacidade, Debloat e Sistema -->
                            <StackPanel Grid.Column="1">
                                <!-- Card Privacidade & Debloat -->
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Privacidade, Telemetria e Aplicativos Padrão" FontSize="14" FontWeight="Bold" Foreground="#BB9AF7" Margin="0,0,0,8" />
                                        <CheckBox Name="chkDisableTelemetry" Content="Desativar telemetria e serviços de diagnóstico" IsChecked="False" ToolTip="Desativa DiagTrack, telemetria de apps, coletor de inventário, relatórios WER de travamentos e propagandas/dicas de nuvem no Iniciar." />
                                        <CheckBox Name="chkDisableCeipTasks" Content="Desativar tarefas agendadas de diagnóstico (CEIP)" IsChecked="False" ToolTip="Desativa rotinas agendadas de telemetria executadas durante períodos de ociosidade." />
                                        <CheckBox Name="chkDisableCopilotRecall" Content="Desativar Windows Copilot e recursos de IA Recall" IsChecked="False" ToolTip="Desativa o assistente Copilot, Cortana e rotinas de análise contínua de tela em segundo plano." />
                                        <CheckBox Name="chkDisableBingSearch" Content="Desativar resultados do Bing no menu Iniciar" IsChecked="False" ToolTip="Mantém a busca do menu Iniciar estritamente local para respostas imediatas." />
                                        <CheckBox Name="chkDebloatEdge" Content="Otimizar telemetria do Microsoft Edge" IsChecked="False" ToolTip="Desativa métricas de navegação, assistentes de compra, persistência de processos ao fechar e pré-carregamento." />
                                        <CheckBox Name="chkRemoveUwpBloat" Content="Remover aplicativos pré-instalados desnecessários" IsChecked="False" ToolTip="Remove pacotes promocionais pré-instalados de entretenimento e redes sociais." />
                                    </StackPanel>
                                </Border>

                                <!-- Card Sistema & Energia -->
                                <Border Style="{StaticResource ProfileCard}">
                                    <StackPanel>
                                        <TextBlock Text="Sistema, Gráficos e Gerenciamento de Energia" FontSize="14" FontWeight="Bold" Foreground="#E0AF68" Margin="0,0,0,8" />
                                        <CheckBox Name="chkCalibrateGpu" Content="Calibrar tolerância de driver gráfico (TdrDelay e HAGS)" IsChecked="False" ToolTip="Aumenta a tolerância para recuperação do driver gráfico e ativa o agendamento de GPU por hardware." />
                                        <CheckBox Name="chkSmartHibernation" Content="Gerenciamento inteligente de hibernação" IsChecked="False" ToolTip="Desativa hibernação em desktop (recupera espaço SSD) ou ativa hibernação compacta e suspende indexação na bateria em notebooks." />
                                        <CheckBox Name="chkDisableReservedStorage" Content="Desativar Armazenamento Reservado do Windows" IsChecked="False" ToolTip="Libera aproximadamente 7 GB de espaço em disco anteriormente retidos pelo sistema operacional." />
                                        <CheckBox Name="chkOptimizeSvcHost" Content="Calibrar divisão de processos de serviços (SvcHost)" IsChecked="False" ToolTip="Ajusta o isolamento de serviços de acordo com a quantidade total de memória RAM." />
                                        <CheckBox Name="chkEnableLongPaths" Content="Habilitar suporte a caminhos longos de arquivos" IsChecked="False" ToolTip="Remove a limitação legada de 260 caracteres (MAX_PATH) em caminhos de arquivos e pastas." />
                                        <CheckBox Name="chkDisableLockScreen" Content="Pular tela de bloqueio estática" IsChecked="False" ToolTip="Apresenta o campo de autenticação diretamente ao ligar ou desbloquear o computador." />
                                        <CheckBox Name="chkIsDev" Content="Configurações para desenvolvedores (Diagnósticos de Boot e RDP)" IsChecked="False" ToolTip="Habilita mensagens detalhadas de inicialização (verbosestatus) e remove avisos repetitivos de conexão RDP." />
                                        <CheckBox Name="chkDualBootUtc" Content="Sincronizar Relógio UTC para Dual Boot (Linux / Fedora)" IsChecked="False" ToolTip="Configura o relógio da placa-mãe em UTC (padrão oficial do Linux) e sincroniza automaticamente com o servidor NTP oficial, eliminando a diferença de horário no dual boot." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Card Independente de Acao e Progresso das Otimizacoes -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="6,12,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Linha 1: Status da otimizacao + Porcentagem -->
                                <TextBlock Name="lblStatusTweaks" Grid.Row="0" Grid.Column="0"
                                           Text="As otimizações são aplicadas diretamente no Registro e nos serviços do sistema."
                                           FontSize="12" Foreground="#7982A9" VerticalAlignment="Center" Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Name="lblPercentTweaks" Grid.Row="0" Grid.Column="1"
                                           Text="0%" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                <!-- Linha 2: Barra de Progresso + Botao de Acao -->
                                <ProgressBar Name="pbTweaks" Grid.Row="1" Grid.Column="0"
                                             Height="10" Minimum="0" Maximum="100" Value="0"
                                             Background="#13141F" Foreground="#22C55E" BorderThickness="0"
                                             Margin="0,0,16,0" VerticalAlignment="Center" />

                                <Button Name="btnApplyOptimizations" Grid.Row="1" Grid.Column="1"
                                        Content="Aplicar Otimizações Selecionadas"
                                        Background="#16A34A" BorderBrush="#22C55E" Foreground="White"
                                        FontWeight="Bold" FontSize="13" Padding="20,10" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== -->
            <!-- ABA 3: RECURSOS OPCIONAIS DO WINDOWS (DISM)              -->
            <!-- ======================================================== -->
            <TabItem Name="tabItemFeatures" Header=" Recursos Opcionais / Extras ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Notificacao de Recursos -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,6,10">
                            <TextBlock Text="Recursos opcionais do Windows gerenciados nativamente via DISM:" FontSize="15" FontWeight="SemiBold" Foreground="#C8D3F5" />
                        </Border>

                        <!-- Perfis Rápidos de Recursos -->
                        <TextBlock Text="Perfis Rápidos de Recursos:" FontSize="14" FontWeight="SemiBold" Foreground="#C8D3F5" Margin="8,4,8,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <!-- Card Perfil Geral -->
                            <Border Style="{StaticResource ProfileCard}">
                                <StackPanel>
                                    <TextBlock Text="Perfil Geral" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Text="Compatibilidade essencial com jogos e programas legados sem consumo extra de recursos." FontSize="12" Foreground="#7982A9" Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="• Habilita apenas o .NET Framework 3.5 (2.0/3.0)&#x0a;• Mantém recursos de virtualização desativados" FontSize="11" Foreground="#C8D3F5" Margin="0,2,0,10" />
                                    <Button Name="btnPresetFeatGeneral" Content="Selecionar Perfil Geral (.NET apenas)" Style="{StaticResource SecondaryButton}" Background="#0284C7" BorderBrush="#38BDF8" Foreground="White" />
                                </StackPanel>
                            </Border>

                            <!-- Card Perfil Dev -->
                            <Border Style="{StaticResource ProfileCard}">
                                <StackPanel>
                                    <TextBlock Text="Perfil Desenvolvedor (Dev)" FontSize="15" FontWeight="Bold" Foreground="#BB9AF7" />
                                    <TextBlock Text="Ambiente completo de desenvolvimento, contêineres e testes seguros isolados." FontSize="12" Foreground="#7982A9" Margin="0,3,0,6" TextWrapping="Wrap" />
                                    <TextBlock Text="• Habilita todos os 5 recursos opcionais&#x0a;• .NET 3.5, WSL2, Hyper-V, Sandbox e Plataforma VM" FontSize="11" Foreground="#C8D3F5" Margin="0,2,0,10" />
                                    <Button Name="btnPresetFeatDev" Content="Selecionar Perfil Desenvolvedor (Tudo)" Style="{StaticResource SecondaryButton}" Background="#7C3AED" BorderBrush="#8B5CF6" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Barra de Ferramentas de Seleção de Recursos -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,6,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Seleção Personalizada de Recursos:" FontSize="14" FontWeight="Bold" Foreground="#C8D3F5" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Name="btnSelectAllFeat" Content="Marcar Todos" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                                    <Button Name="btnDeselectAllFeat" Content="Desmarcar Todos" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Border Style="{StaticResource ProfileCard}">
                            <StackPanel>
                                <TextBlock Text="Componentes e Recursos do Sistema" FontSize="14" FontWeight="Bold" Foreground="#7DCFFF" Margin="0,0,0,8" />
                                <CheckBox Name="featNetFx3" Content=".NET Framework 3.5 (Compatibilidade legada com versões 2.0 e 3.0)" IsChecked="False" />
                                <CheckBox Name="featWsl" Content="Subsistema do Windows para Linux (WSL2)" IsChecked="False" />
                                <CheckBox Name="featVmPlatform" Content="Plataforma de Máquina Virtual (Pré-requisito do WSL2)" IsChecked="False" />
                                <CheckBox Name="featHyperV" Content="Hyper-V (Virtualização nativa para máquinas virtuais e Docker)" IsChecked="False" />
                                <CheckBox Name="featSandbox" Content="Windows Sandbox (Ambiente isolado para testes seguros)" IsChecked="False" />
                            </StackPanel>
                        </Border>

                        <!-- Card Independente de Acao e Progresso de Recursos DISM -->
                        <Border Background="#1A1B26" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="6,12,6,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Linha 1: Status do recurso + Porcentagem -->
                                <TextBlock Name="lblStatusFeatures" Grid.Row="0" Grid.Column="0"
                                           Text="Requer conexão com a internet para baixar arquivos de componentes adicionais da Microsoft."
                                           FontSize="12" Foreground="#7982A9" VerticalAlignment="Center" Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Name="lblPercentFeatures" Grid.Row="0" Grid.Column="1"
                                           Text="0%" FontSize="12" FontWeight="Bold" Foreground="#BB9AF7"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,8" />

                                <!-- Linha 2: Barra de Progresso + Botao de Acao -->
                                <ProgressBar Name="pbFeatures" Grid.Row="1" Grid.Column="0"
                                             Height="10" Minimum="0" Maximum="100" Value="0"
                                             Background="#13141F" Foreground="#8B5CF6" BorderThickness="0"
                                             Margin="0,0,16,0" VerticalAlignment="Center" />

                                <Button Name="btnEnableFeatures" Grid.Row="1" Grid.Column="1"
                                        Content="Habilitar Recursos Selecionados"
                                        Background="#7C3AED" BorderBrush="#8B5CF6" Foreground="White"
                                        FontWeight="Bold" FontSize="13" Padding="20,10" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== -->
            <!-- ABA 4: REGISTRO E LOGS EM TEMPO REAL                     -->
            <!-- ======================================================== -->
            <TabItem Name="tabItemLog" Header=" Registro e Logs ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Acompanhamento em tempo real da execução e auditoria de sistema:" FontSize="13" Foreground="#7982A9" VerticalAlignment="Center" />
                        <Button Name="btnBackToOptions" Content="⬅ Voltar às Opções" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,3" FontSize="11" Background="#2563EB" BorderBrush="#3B82F6" Foreground="White" FontWeight="Bold" />
                        <Button Name="btnOpenLogFolder" Content="Abrir Pasta de Logs" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="8,3" FontSize="11" />
                        <Button Name="btnClearLogConsole" Content="Limpar Console" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="8,3" FontSize="11" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0A0B10" BorderBrush="#2F354F" BorderThickness="1" CornerRadius="8" Padding="8">
                        <TextBox Name="txtConsoleLog" Background="Transparent" Foreground="#9ECE6A" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="DEWIN Booster pronto. Selecione programas ou otimizações para começar." />
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>


    </Grid>
</Window>
